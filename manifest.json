{
  "manifest_version": 3,
  "name": "Fudge — Review Library",
  "short_name": "Fudge",
  "version": "0.29.1",
  "key": "",
  "description": "Collect and classify five-star Google reviews, fulfill Sheet requirements, and preserve review inventory.",
  "permissions": ["activeTab", "alarms", "clipboardWrite", "notifications", "storage", "unlimitedStorage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.google.com/*",
    "https://www.google.com/search*",
    "https://*.googleusercontent.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://api.openai.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open Fudge",
    "default_icon": { "16": "assets/logo.png", "32": "assets/logo.png", "48": "assets/logo.png", "128": "assets/logo.png" }
  },
  "icons": { "16": "assets/logo.png", "32": "assets/logo.png", "48": "assets/logo.png", "128": "assets/logo.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*", "https://maps.google.com/*", "https://www.google.com/search*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
